#!/usr/bin/env python3
"""plan — a session todo list with replace semantics (dsh's todo_write shape, host-side).

  plan set '<json>'   replace the whole list and print it; <json> is a list of
                      {"content": "...", "status": "pending|in_progress|completed"}
  plan show           print the current list

State lives in ./.plan.json (the session's working directory)."""
import json, os, sys

PATH = os.path.join(os.getcwd(), ".plan.json")
MARK = {"pending": "[ ]", "in_progress": "[>]", "completed": "[x]"}

def load():
    try:
        with open(PATH) as f:
            return json.load(f)
    except (OSError, ValueError):
        return []

def show(items):
    if not items:
        print("plan: (empty)"); return
    for i, it in enumerate(items, 1):
        print(f"{i}. {MARK.get(it.get('status'), '[?]')} {it.get('content', '')}")
    open_ = sum(1 for it in items if it.get("status") != "completed")
    print(f"-- {len(items)} steps, {open_} open")

cmd = sys.argv[1] if len(sys.argv) > 1 else "help"
if cmd == "set" and len(sys.argv) > 2:
    try:
        items = json.loads(sys.argv[2])
    except ValueError as e:
        print(f"plan: bad JSON: {e}"); sys.exit(2)
    if not isinstance(items, list) or not all(isinstance(i, dict) and "content" in i for i in items):
        print('plan: expected a JSON list of {"content": ..., "status": ...}'); sys.exit(2)
    for it in items:
        it.setdefault("status", "pending")
    bad = [it["status"] for it in items if it["status"] not in MARK]
    if bad:
        print(f"plan: bad status {bad}; use pending|in_progress|completed"); sys.exit(2)
    with open(PATH, "w") as f:
        json.dump(items, f)
    show(items)
elif cmd == "show":
    show(load())
else:
    print(__doc__); sys.exit(0 if cmd in ("help", "-h", "--help") else 2)
