#!/bin/sh
# web-probe <file.html> [--json out.json]
# Runs an HTML page in a real headless Chrome (the GPU box, via the rig tunnel)
# and reports: uncaught exceptions with locations, console errors, animation
# frames/s, whether the page responds to a click + key burst, screenshots.
# First line is `VERIFY web PASS|FAIL`; exit code follows it. Cold load ~25 s.
H=$(CDPATH= cd "$(dirname "$0")/../.." && pwd)
export PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-$HOME/.cache/ms-playwright}
exec ${WEB_PROBE_PY:-/usr/local/bin/python3.11} "$H/web_probe.py" --remote-host "${WEB_PROBE_REMOTE_HOST:-ollama}" "$@"
